# ─── CAZA VISION — Notion Integration ─────────────────────────────────────────
#
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and should NEVER be committed.
#
# Where to find these values:
#
#   NOTION_TOKEN:
#     1. Acesse https://www.notion.so/my-integrations
#     2. Crie uma nova integração (ou use uma existente)
#     3. Copie o "Internal Integration Token" (começa com "secret_")
#     4. Na página da base no Notion, clique em "..." > "Add connections"
#        e adicione a integração criada
#
#   CAZA_VISION_DB_ID:
#     1. Abra a base de dados da CAZA VISION no Notion
#     2. Copie a URL da página — ela tem o formato:
#        https://www.notion.so/workspace/<NOME>-<DATABASE_ID>?v=...
#     3. O DATABASE_ID é a parte sem hífens antes do "?v="
#        Exemplo: https://www.notion.so/caza-vision-abc123def456...
#        → CAZA_VISION_DB_ID=abc123def456...
#     OBS: O ID também pode ser formatado com hífens:
#        xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CAZA_VISION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Schema esperado na base do Notion ────────────────────────────────────────
#
# A integração espera as seguintes propriedades na base:
#
#   Nome do projeto  (title)    — Nome do projeto [OBRIGATÓRIO]
#   Prioridade       (select)   — Nível de prioridade [OPCIONAL]
#   Responsável      (people)   — Responsável pelo projeto [OPCIONAL]
#   COMPETÊNCIA      (date)     — Mês de competência do faturamento [RECOMENDADO]
#   Recebimento      (date)     — Data de recebimento do pagamento [OPCIONAL]
#   Recebido         (checkbox) — Indica se o pagamento foi recebido [RECOMENDADO]
#   Valor            (number)   — Valor do projeto em R$ [OBRIGATÓRIO p/ métricas]
#   Alimentação      (number)   — Despesa de alimentação em R$ [OPCIONAL]
#   Gasolina         (number)   — Despesa de combustível em R$ [OPCIONAL]
#
# NOTA: Campos com type diferente do esperado são tratados com fallback seguro.
# Campos ausentes não quebram a aplicação — apenas reduzem as métricas disponíveis.
